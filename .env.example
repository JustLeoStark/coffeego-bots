# Copy to .env and fill in. Never commit the real .env.

# --- Telegram (required to run the Telegram bot) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Обязателен при PUBLIC_URL: секрет вебхука (16–256 знаков A-Z a-z 0-9 _ -).
# Без него бот снимает вебхук и в Telegram не отвечает.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Optional: default chat/group id that receives everything (fallback for all roles)
TELEGRAM_ADMIN_CHAT_ID=
# Optional per-role routing (each = a Telegram chat id). Unset roles fall back to ADMIN.
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_INVEST_CHAT_ID=

# --- Public URL of this service (for Telegram webhook auto-registration) ---
# e.g. https://coffeego-bot.onrender.com  (leave empty to use manual setWebhook)
PUBLIC_URL=

# --- Bitrix24 inbound webhook (leads go here) ---
# Create in Bitrix24: Developer resources -> Other -> Inbound webhook -> scope: crm
# Paste the base URL including the token and trailing slash.
BITRIX_WEBHOOK_URL=
# Optional: Bitrix user id to assign leads to
BITRIX_ASSIGNED_TO=
# 0 — выключить Bitrix24 (после перехода на CoffeeGo CRM). Пусто/1 — как было
BITRIX_ENABLED=1

# --- CoffeeGo CRM: переписка Telegram в карточках лида и клиента ---
# Каждое сообщение лички клиента с ботом и каждый ответ бота уходят в
# CRM_URL/integrations/telegram/ingest, заявки с сайта — в /integrations/web-lead,
# подписанные CRM_INGEST_SECRET. Им же CRM подписывает POST /crm/handoff
# («отвечает человек, бот молчит»). Секрет — тот же, что TELEGRAM_INGEST_SECRET
# на сервере CRM, не короче 32 знаков; CRM_URL — только https://. Иначе
# пересылка выключена (ошибка в журнале) и /crm/handoff не принимается.
CRM_URL=
CRM_INGEST_SECRET=
# Сколько ждать ответа CRM, мс (дальше — в очередь повторов)
CRM_TIMEOUT_MS=5000

# --- WhatsApp Cloud API (Meta) ---
# Постоянный токен System User (не временный 24-часовой из панели разработчика)
WHATSAPP_TOKEN=
# Phone number ID из WhatsApp → API Setup (это НЕ сам номер телефона)
WHATSAPP_PHONE_ID=
# Любая строка; её же вписать в Meta при настройке вебхука
WHATSAPP_VERIFY_TOKEN=coffeego-verify-choose-any-string
# App Secret из настроек приложения Meta. Включает проверку подписи вебхука —
# без него любой, кто узнает адрес, сможет прислать боту фальшивое сообщение
WHATSAPP_APP_SECRET=

# Самопинг против засыпания бесплатного Render (0 — выключить)
KEEP_AWAKE=1

# --- AI brain (Anthropic Claude) — powers option 5 free chat ---
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Persistence for staff, assignments and live handoff (Upstash Redis REST) ---
# Create a free DB at upstash.com -> Redis, copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Port (hosting platforms set this automatically)
PORT=3000

# Обязателен для заявок с сайта: JWS secret token исходящего вебхука формы
# в Netlify (та же строка). Без него /netlify/lead отвечает 401 всем.
# Не короче 32 знаков. Запасной способ — ?key=<секрет> в адресе вебхука —
# только при NETLIFY_ALLOW_KEY=1.
NETLIFY_LEAD_SECRET=
NETLIFY_ALLOW_KEY=0
