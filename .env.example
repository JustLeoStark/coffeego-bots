# Copy to .env and fill in. Never commit the real .env.

# --- Telegram (required to run the Telegram bot) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Optional: default chat/group id that receives everything (fallback for all roles)
TELEGRAM_ADMIN_CHAT_ID=
# Optional per-role routing (each = a Telegram chat id). Unset roles fall back to ADMIN.
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_INVEST_CHAT_ID=

# --- Public URL of this service (for Telegram webhook auto-registration) ---
# e.g. https://coffeego-bot.onrender.com  (leave empty to use manual setWebhook)
PUBLIC_URL=

# --- Bitrix24 inbound webhook (leads go here) ---
# Create in Bitrix24: Developer resources -> Other -> Inbound webhook -> scope: crm
# Paste the base URL including the token and trailing slash.
BITRIX_WEBHOOK_URL=
# Optional: Bitrix user id to assign leads to
BITRIX_ASSIGNED_TO=

# --- WhatsApp Cloud API (Meta) ---
# Постоянный токен System User (не временный 24-часовой из панели разработчика)
WHATSAPP_TOKEN=
# Phone number ID из WhatsApp → API Setup (это НЕ сам номер телефона)
WHATSAPP_PHONE_ID=
# Любая строка; её же вписать в Meta при настройке вебхука
WHATSAPP_VERIFY_TOKEN=coffeego-verify-choose-any-string
# App Secret из настроек приложения Meta. Включает проверку подписи вебхука —
# без него любой, кто узнает адрес, сможет прислать боту фальшивое сообщение
WHATSAPP_APP_SECRET=

# Самопинг против засыпания бесплатного Render (0 — выключить)
KEEP_AWAKE=1

# --- AI brain (Anthropic Claude) — powers option 5 free chat ---
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Persistence for staff, assignments and live handoff (Upstash Redis REST) ---
# Create a free DB at upstash.com -> Redis, copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Port (hosting platforms set this automatically)
PORT=3000

# Optional: shared secret for Netlify form webhook (append ?key=... to the webhook URL)
NETLIFY_LEAD_SECRET=
